{
  "name": "poochydex",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "prebuild": "node generate-env.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:tailwind": "tailwindcss build src/styles/styles.scss -o src/tailwind.css",
    "lint": "ng lint",
    "android:sync": "ng build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:icons": "npx @capacitor/assets generate --android",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:release:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:release:aab": "npm run android:sync && cd android && ./gradlew bundleRelease"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.6",
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.6",
    "@angular/platform-browser-dynamic": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@angular/service-worker": "^22.0.6",
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "rxjs": "~7.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "~3.10.0",
    "@types/node": "^12.11.1",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.7.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~3.10.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "tailwindcss": "^3.4.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
